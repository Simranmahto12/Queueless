# ==============================================================================
# QueueLess Global Environment Configuration Template
# Copy this file to .env.local or appropriate module .env files
# DO NOT COMMIT ACTUAL SECRETS OR SERVICE ACCOUNT KEYS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public / Client-Safe)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web / Android
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Expo Mobile App equivalents
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:android:abcdef123456

# ------------------------------------------------------------------------------
# 2. Local Firebase Emulator Integration
# Set to 'true' to redirect traffic from live Google servers to local emulators
# ------------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_USE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# ------------------------------------------------------------------------------
# 3. Server-Side Secrets (Cloud Functions / CI/CD only)
# NEVER pass service account keys or private keys into frontend applications
# ------------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
